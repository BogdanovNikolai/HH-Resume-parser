# === Redis Configuration ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password  # Опционально
REDIS_KEY_PREFIX=hh_app_

# === HeadHunter API Tokens ===
CLIENT_ID1=your_client_id_1
CLIENT_SECRET1=your_client_secret_1
ACCESS_TOKEN1=your_access_token_1
REFRESH_TOKEN1=your_refresh_token_1
REDIRECT_URI1=https://your_redirect_uri 

CLIENT_ID2=your_client_id_2
CLIENT_SECRET2=your_client_secret_2
ACCESS_TOKEN2=your_access_token_2
REFRESH_TOKEN2=your_refresh_token_2
REDIRECT_URI2=https://your_redirect_uri 

# === DeepSeek API (для оценки резюме) ===
DEEPSEEK_API_KEY=your_deepseek_api_key

# === Flask App ===
SECRET_KEY=your_flask_secret_key